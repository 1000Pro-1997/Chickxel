<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Chickxel.Core\Chickxel.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Chickxel</AssemblyTitle>
    <Product>Chickxel</Product>
    <AssemblyName>Chickxel.App</AssemblyName>
    <!-- 기본(중립) 언어 문구 = 한국어. 다른 언어는 Localization/*.<언어>.resx 위성 어셈블리. -->
    <NeutralLanguage>ko</NeutralLanguage>
    <!-- UI는 모두 코드로 만든다(XAML 없음). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows exe 아이콘(기본 병아리를 놓은 16×16 점 그림을 정수배로 키운 16~256) -->
    <ApplicationIcon>Assets\AppIcon\chickxel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 도구 아이콘(32×32 PNG)과 창 아이콘 -->
    <AvaloniaResource Include="Assets\Tools\*.png" />
    <AvaloniaResource Include="Assets\AppIcon\chickxel-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 픽셀로 정리 기본 프리셋(처음 설치·기본값 되살리기). Settings는 단계 설정 JSON 객체 그대로, 나머지는 OptimizePreset과 같은 이름. -->
    <EmbeddedResource Include="Assets\Pixelate\default-presets.json" LogicalName="Chickxel.Pixelate.default-presets.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- F1 사용 가이드: docs/guide.html·docs/en/guide.html에서 tools/build-help.py로 만든 쪽 데이터.
         이름의 .ko/.en을 언어로 보고 위성 어셈블리로 빼지 않게 WithCulture=false. -->
    <EmbeddedResource Include="Assets\Help\help.*.json" LogicalName="Chickxel.Help.%(Filename)%(Extension)" WithCulture="false" />
    <!-- 가이드 움짤(홈페이지 대표 기능 영상을 8fps로 줄인 것과 가이드 쪽 화면 녹화 30fps, 움직이는 WebP, DEVELOPMENT.md 참고). README 대표 기능 움짤로도 씀. -->
    <EmbeddedResource Include="Assets\Help\media\*.webp" LogicalName="Chickxel.Help.media.%(Filename)%(Extension)" WithCulture="false" />
    <!-- 가이드 화면 그림(docs/assets/guide/*.png를 build-help.py가 무손실 WebP로 옮긴 것, 빨간 번호 표시 포함). -->
    <EmbeddedResource Include="Assets\Help\shots\*.webp" LogicalName="Chickxel.Help.shots.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <!-- 효과 만들기의 스크립트 코드 편집기(문법 색칠·자동 완성 창). 순수 .NET이라 exe·.app에 그대로 묶인다. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="5.0.0-1.25277.114" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Localization/<클래스>.resx → 같은 이름의 정적 클래스(속성 = 문구, Format… = 자리 표시자 채우기) -->
    <EmbeddedResource Update="Localization\*.resx" Public="true" EmitFormatMethods="true" OmitGetResourceString="true" />
  </ItemGroup>

</Project>
