<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Gpixel.Core\Gpixel.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Gpixel</AssemblyTitle>
    <Product>Gpixel</Product>
    <AssemblyName>Gpixel.App</AssemblyName>
    <!-- 기본(중립) 언어 문구 = 한국어. 다른 언어는 Localization/*.<언어>.resx 위성 어셈블리. -->
    <NeutralLanguage>ko</NeutralLanguage>
    <!-- UI는 모두 코드로 만든다(XAML 없음). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows exe 아이콘(32×32 점 그림에서 만든 16~256) -->
    <ApplicationIcon>Assets\AppIcon\gpixel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 도구 아이콘(32×32 PNG)과 창 아이콘 -->
    <AvaloniaResource Include="Assets\Tools\*.png" />
    <AvaloniaResource Include="Assets\AppIcon\gpixel-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- F1 사용 가이드: docs/guide.html·docs/en/guide.html에서 tools/build-help.py로 만든 쪽 데이터.
         이름의 .ko/.en을 언어로 보고 위성 어셈블리로 빼지 않게 WithCulture=false. -->
    <EmbeddedResource Include="Assets\Help\help.*.json" LogicalName="Gpixel.Help.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="5.0.0-1.25277.114" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Localization/<클래스>.resx → 같은 이름의 정적 클래스(속성 = 문구, Format… = 자리 표시자 채우기) -->
    <EmbeddedResource Update="Localization\*.resx" Public="true" EmitFormatMethods="true" OmitGetResourceString="true" />
  </ItemGroup>

</Project>
